# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma separated list of origins allowed by CORS (web app URLs)
CORS_ORIGINS=http://localhost:5173

# ── Supabase (Project Settings → API) ───────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server only! Never expose this key to the web/mobile apps.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI (https://console.groq.com) ───────────────────────
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b

# ── Shipping rates (https://rajaongkir.komerce.id) ──────
RAJAONGKIR_API_KEY=your-rajaongkir-key

# ── Access control ──────────────────────────────────────
# Comma separated emails that get the admin dashboard
ADMIN_EMAILS=admin@example.com

# ── Optional: Telegram bot (leave empty to disable) ─────
TELEGRAM_BOT_TOKEN=
